  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime shape",
      "items": [
        "Single static Go binary (CGO_ENABLED=0) serves the embedded SPA over localhost",
        "UI is a system Chromium window in --app mode \u2014 no Electron",
        "API types hand-mirrored in frontend/src/lib/api-types.ts \u2014 no codegen"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sessions",
      "items": [
        "Seven provider CLIs behind one registry \u2014 Claude Code, Codex, Antigravity, opencode, oh-my-pi, Crush, Cursor",
        "Per-OS PTY picked by build tags; opt-in bwrap/seatbelt sandbox",
        "A delegated session can get its own git worktree (internal/project)"
      ]
    },
    {
      "dot": "amber",
      "title": "Trust boundaries",
      "items": [
        "Every /rpc call carries the session token; hook scripts call back over HTTP with it",
        "Hook scripts ship from the companion repo omartelo/lich-plugin \u2014 contract-first",
        "Agent CLIs are untrusted subprocesses; lich talks to them only through the PTY"
      ]
    }
  ]
