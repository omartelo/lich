  "cards": [
    {
      "dot": "emerald",
      "title": "Order is deliberate",
      "items": [
        "Row and card are announced before the spawn: a session only the database knows about is one the user cannot reach",
        "A failed model write must not hide the session \u2014 it is reported once the terminal is running",
        "One lock spans checkout + write + spawn: a duplicate label is the expensive bug, not the cheap PTY"
      ]
    },
    {
      "dot": "amber",
      "title": "Checkout rules",
      "items": [
        "An existing checkout for the branch is opened, not recreated \u2014 only a fresh one runs the setup script",
        "A base without a worktree is refused rather than dropped in silence",
        "The card takes the branch name unless a live session already answers to it \u2014 then the project counter"
      ]
    },
    {
      "dot": "violet",
      "title": "Birth facts",
      "items": [
        "The session is named at birth (--name, relay roster) \u2014 rename later never changes the spawn name",
        "The origin session is recorded on the row and outlives the request that created it",
        "Model, when given, is recorded so every later spawn repeats it \u2014 in the provider's own spelling"
      ]
    }
  ]
